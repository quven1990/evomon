# https://developers.cloudflare.com/workers/static-assets/headers
# Later matching rules override earlier ones for the same header.

# Default: cache HTML at the edge (browser still revalidates).
# Cuts origin misses that were producing ~15% 504s on HTML routes.
/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/
  Link: </images/hero.webp>; rel=preload; as=image; fetchpriority=high
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

# Hashed Next assets — long-lived, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800, immutable

/pets/*
  Cache-Control: public, max-age=604800, immutable

# Static Adsterra iframe shells (also hit 504 when uncached)
/ads/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
